{
  "surface_kind": "opl_capability_package_manifest.v2",
  "package_id": "opl-fleet-agent",
  "display_name": "OPL Fleet Agent",
  "publisher": "one-person-lab",
  "version": "0.2.38",
  "source": "first_party",
  "package_role": "capability_package",
  "source_repo": "https://github.com/gaofeng21cn/opl-fleet-agent.git",
  "machine_boundary": "This Package projects sanitized node-local observations from the installed native OPL Fleet Agent. It does not own native installation, collection, upgrade, fleet admission, leases, dispatch, task completion, execution constraints, receipts, or Cordis Host truth.",
  "capability_abi": {
    "id": "opl-fleet-agent.capabilities",
    "version": "1.0.0",
    "compatibility_policy": "same_major"
  },
  "exports": {
    "core_skill_ids": [
      "opl-fleet-agent"
    ],
    "core_module_ids": [
      "fleet.agent.telemetry.v1",
      "fleet.agent.doctor.v1"
    ],
    "optional_skill_policy_ref": "opl-package.json#/exports",
    "optional_skills_installed_by_default": true,
    "default_materialization_policy": "all_exported_skills"
  },
  "content_lock": {
    "algorithm": "sha256",
    "canonicalization": "ordered_path_length_file_length_bytes",
    "paths": [
      ".codex-plugin/plugin.json",
      "bin/opl-fleet-agent.mjs",
      "plugin.json",
      "skills/opl-fleet-agent/SKILL.md",
      "skills/opl-fleet-agent/agents/openai.yaml"
    ],
    "digest": "sha256:ed9f493a9858449d323a20f9c51697b0bc7cf37567e227a218917ac7d4628c6f"
  },
  "codex_surface": {
    "plugin_id": "opl-fleet-agent",
    "plugin_source_path": ".",
    "codex_default_exposure": false,
    "optional_install_policy": "all_exported_skills",
    "app_contribution_abi": {
      "schema_version": "opl-package-app-contribution-cli.v1",
      "transport": "stdin_json_stdout_json",
      "argv": [
        "node",
        "./bin/opl-fleet-agent.mjs"
      ],
      "request_schema": "opl-package-app-contribution-request.v1",
      "response_schema": "opl-package-app-contribution-response.v1"
    }
  },
  "app_contributions": {
    "schema_version": "opl-app-contributions.v1",
    "views": [
      {
        "view_id": "fleet.agent.telemetry",
        "view_type": "activity_log",
        "title_i18n": {
          "zh-CN": "本机 Fleet Agent 遥测",
          "en-US": "Local Fleet Agent telemetry"
        },
        "data_ref": "fleet.agent.telemetry.v1#local",
        "badge_ids": [
          "fleet.agent.health"
        ],
        "empty_state_i18n": {
          "zh-CN": "本机 Fleet Agent 暂无可用遥测",
          "en-US": "Local Fleet Agent telemetry is unavailable"
        }
      },
      {
        "view_id": "fleet.agent.doctor",
        "view_type": "activity_log",
        "title_i18n": {
          "zh-CN": "本机 Fleet Agent 诊断",
          "en-US": "Local Fleet Agent doctor"
        },
        "data_ref": "fleet.agent.doctor.v1#current",
        "badge_ids": [
          "fleet.agent.health"
        ],
        "empty_state_i18n": {
          "zh-CN": "本机 Fleet Agent 诊断不可用",
          "en-US": "Local Fleet Agent doctor is unavailable"
        }
      }
    ],
    "badges": [
      {
        "badge_id": "fleet.agent.health",
        "label_i18n": {
          "zh-CN": "本机 Agent",
          "en-US": "Local agent"
        },
        "data_ref": "fleet.agent.doctor.v1#current",
        "tone": "neutral"
      }
    ],
    "ui": [
      {
        "contribution_id": "fleet.agent.telemetry-settings",
        "slot": "settings.section",
        "contribution_kind": "view",
        "trust_tier": "declarative",
        "scope": "root",
        "sort_order": 300,
        "view_id": "fleet.agent.telemetry"
      },
      {
        "contribution_id": "fleet.agent.doctor-settings",
        "slot": "settings.section",
        "contribution_kind": "view",
        "trust_tier": "declarative",
        "scope": "root",
        "sort_order": 310,
        "view_id": "fleet.agent.doctor"
      }
    ]
  }
}
