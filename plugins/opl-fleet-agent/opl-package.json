{
  "schema_version": "opl.package.v2",
  "identity": {
    "id": "opl-fleet-agent",
    "version": "0.2.57",
    "intent": "extension",
    "name": {
      "zh-CN": "OPL Fleet Agent Integration",
      "en-US": "OPL Fleet Agent Integration"
    },
    "summary": {
      "zh-CN": "检查本机 Fleet Agent 的运行健康状态和遥测信息。",
      "en-US": "Inspect local Fleet Agent health and telemetry."
    },
    "description": {
      "zh-CN": "读取本机 OPL Fleet Agent 的脱敏遥测和限定范围的诊断结果，保护会话内容和 Fleet 权限决策。",
      "en-US": "Read sanitized node-local OPL Fleet Agent telemetry and bounded doctor results without exposing conversation content or fleet authority decisions."
    },
    "publisher": "one-person-lab",
    "license": "Apache-2.0",
    "repository": "https://github.com/gaofeng21cn/opl-fleet-agent.git",
    "keywords": [
      "fleet",
      "telemetry",
      "doctor",
      "opl"
    ]
  },
  "dependencies": {
    "opl_base": "^2.0.0"
  },
  "provides": {
    "module_ids": [
      "fleet.agent.telemetry.v1",
      "fleet.agent.doctor.v1"
    ],
    "skills": [
      {
        "id": "opl-fleet-agent",
        "path": "./skills/opl-fleet-agent",
        "exposure": "default"
      }
    ],
    "contribution_handler": {
      "kind": "cli",
      "argv": [
        "node",
        "./bin/opl-fleet-agent.mjs"
      ],
      "transport": "stdin_json_stdout_json"
    }
  },
  "ui": {
    "declarative": {
      "views": [
        {
          "id": "fleet.agent.telemetry",
          "view_type": "activity_log",
          "slot": "settings.section",
          "settings_destination": "resources",
          "title": {
            "zh-CN": "本机 Fleet Agent 遥测",
            "en-US": "Local Fleet Agent telemetry"
          },
          "data_ref": "fleet.agent.telemetry.v1#local",
          "empty_state": {
            "zh-CN": "本机 Fleet Agent 暂无可用遥测",
            "en-US": "Local Fleet Agent telemetry is unavailable"
          },
          "sort_order": 1300
        },
        {
          "id": "fleet.agent.doctor",
          "view_type": "activity_log",
          "slot": "settings.section",
          "settings_destination": "resources",
          "title": {
            "zh-CN": "本机 Fleet Agent 诊断",
            "en-US": "Local Fleet Agent doctor"
          },
          "data_ref": "fleet.agent.doctor.v1#current",
          "empty_state": {
            "zh-CN": "本机 Fleet Agent 诊断不可用",
            "en-US": "Local Fleet Agent doctor is unavailable"
          },
          "sort_order": 1301
        }
      ]
    }
  },
  "distribution": {
    "oci": "ghcr.io/gaofeng21cn/one-person-lab-packages/opl-fleet-agent",
    "visibility": "public"
  },
  "host_hints": {
    "codex": {
      "sync_enabled": false,
      "plugin_name": "opl-fleet-agent",
      "category": "Productivity",
      "capabilities": [
        "Local telemetry",
        "Node doctor"
      ]
    }
  }
}
